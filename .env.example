# --- Kapso ---
KAPSO_API_KEY=            # Kapso dashboard -> Integrations -> API keys
WEBHOOK_SECRET=           # the secret_key you set when registering the webhook

# --- Who may use the bot (REQUIRED: the bot can create GitHub issues) ---
ALLOWED_SENDERS=+923001234567   # comma-separated phone numbers

# --- LLM: any OpenAI-compatible API. Example (Groq free tier): ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=                # pick a current model from your provider's model list

# --- GitHub (use YOUR OWN repo, fine-grained token with Issues: read/write on that repo only) ---
GITHUB_TOKEN=
GITHUB_REPO=yourname/kapso-notes

# --- Misc ---
DB_PATH=bot.db
LOG_PAYLOADS=1            # print incoming payloads while you confirm the field names; remove later
